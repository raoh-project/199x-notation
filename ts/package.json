{
  "name": "@raoh/199x-notation",
  "version": "0.2.0-dev",
  "description": "The rules for reading text that Raoh and Souther share: Unicode 18.0.0 White_Space, order and length in scalar values, and temporal text",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raoh-project/199x-notation.git",
    "directory": "ts"
  },
  "keywords": ["unicode", "white-space", "iso8601", "date", "time"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0"
  }
}
